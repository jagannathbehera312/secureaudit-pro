# SecureAudit Pro - Environment Configuration

# Django Core
DJANGO_SECRET_KEY=change-me-to-a-secure-random-64-character-string
DEBUG=False
ALLOWED_HOSTS=*

# MongoDB Connection
MONGODB_URI=mongodb://secureaudit_user:AuditPass2026!@localhost:27017/secureaudit_pro?authSource=admin
MONGODB_DB_NAME=secureaudit_pro
USE_MOCK_DB=False

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# Security Scanners
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=
NUCLEI_BIN_PATH=/usr/local/bin/nuclei

# Root Credentials for MongoDB container
MONGO_INITDB_ROOT_USERNAME=secureaudit_user
MONGO_INITDB_ROOT_PASSWORD=AuditPass2026!
